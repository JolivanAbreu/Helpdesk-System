# Copie para .env (no Windows: copy .env.example .env)

# Endereço da API do backend
VITE_API_URL=http://localhost:3000/api

# Mostra as contas de demonstração na tela de login (use false em produção real)
VITE_MODO_DEMO=true

# Demonstração sem servidor: a API é simulada no navegador e os dados ficam
# no localStorage. Use true só na publicação de portfólio (ex.: Vercel).
VITE_DEMO_LOCAL=false
