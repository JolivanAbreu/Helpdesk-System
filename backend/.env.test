# Configuração usada só pelos testes automatizados (npm test).
# Valores já definidos no ambiente (ex.: no GitHub Actions) têm prioridade.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk_user
DB_PASSWORD=user_password_segura
DB_NAME=helpdesk_test
DB_LOGGING=false

# Usada só para criar o banco de teste e dar acesso a ele (mesma do docker-compose)
DB_ROOT_PASSWORD=root_password_segura

JWT_SECRET=segredo_usado_apenas_nos_testes
LIMITE_TENTATIVAS_AUTH=100000
UPLOADS_DIR=tmp/uploads-test
