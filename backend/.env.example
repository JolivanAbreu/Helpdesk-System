# Copie este arquivo para .env (cp .env.example .env)
# Os valores de banco abaixo já batem com o docker-compose.yml da raiz.

PORT=3000

# Endereço do frontend (único site autorizado a chamar a API via CORS)
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=helpdesk_user
DB_PASSWORD=user_password_segura
DB_NAME=helpdesk_db

# Mostra cada SQL executado no terminal (true/false)
DB_LOGGING=false

# Troque por um texto longo e aleatório.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
