# Dependências
node_modules/

# Variáveis de ambiente (o modelo fica em backend/.env.example)
.env

# Build
/frontend/dist

# Arquivos enviados pelos usuários (a pasta é mantida pelo .gitkeep)
/backend/tmp/uploads/*
!/backend/tmp/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional / editor
.DS_Store
Thumbs.db
